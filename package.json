{
  "name": "threaddeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "kimaki": "node scripts/kimaki.mjs",
    "kimaki:prepare": "node scripts/prepare-kimaki-fork.mjs",
    "kimaki:test": "node scripts/smoke-kimaki-fork.mjs",
    "kimaki:local": "node scripts/local-kimaki.mjs",
    "kimaki:desktop": "node scripts/kimaki.mjs --desktop",
    "desktop": "node scripts/desktop.mjs",
    "desktop:install": "node scripts/install-windows-launcher.mjs",
    "prototype:dashboard": "node scripts/render-dashboard-prototype.mjs",
    "prototype:chat": "node scripts/chat-workspace-prototype.mjs",
    "test:desktop": "node --test scripts/desktop.test.mjs",
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/build-dashboard-tests.mjs && playwright test",
    "test:chat:browser": "npm run build && playwright test --config playwright.chat.config.ts",
    "check": "npm test && npm run test:desktop && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@opencode/client": "2.0.29",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@replit/codemirror-vim": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.1",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
